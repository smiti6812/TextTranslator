<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TextTranslator.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TextTranslator"
    xmlns:views="clr-namespace:TextTranslator.Views"
    Title="Language App">


    <TabBar>
        <ShellContent Title="Szótár" ContentTemplate="{DataTemplate views:VocabularyListPage}" Route="VocabularyListPage" />
        <ShellContent Title="Import" ContentTemplate="{DataTemplate views:ImportPage}" Route="ImportPage" />
        <ShellContent Title="Quiz" ContentTemplate="{DataTemplate views:QuizPage}" Route="QuizPage" />
        <ShellContent Title="Beállítások" ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
    </TabBar>

</Shell>
