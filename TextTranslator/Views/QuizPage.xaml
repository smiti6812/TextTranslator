<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TextTranslator.Views.QuizPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <HorizontalStackLayout Spacing="10">
                <Label Text="Irány:" VerticalOptions="Center" />
                <Switch IsToggled="{Binding SourceToTarget}" />
                <Label Text="Forrás → Cél" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="Betöltés" Command="{Binding LoadCommand}" />
            <Button Text="Felolvasás" Command="{Binding SpeakQuestionCommand}" />

            <Label Text="{Binding QuestionText}" FontSize="28" FontAttributes="Bold" />

            <Button Text="{Binding Option1}" Command="{Binding AnswerCommand}" CommandParameter="{Binding Option1}" />
            <Button Text="{Binding Option2}" Command="{Binding AnswerCommand}" CommandParameter="{Binding Option2}" />
            <Button Text="{Binding Option3}" Command="{Binding AnswerCommand}" CommandParameter="{Binding Option3}" />
            <Button Text="{Binding Option4}" Command="{Binding AnswerCommand}" CommandParameter="{Binding Option4}" />

            <Label Text="{Binding ResultText}" />
            <Label Text="{Binding ScoreText}" />

            <Button Text="Következő" Command="{Binding LoadNextQuestionCommand}" />
            <Button Text="Összesítés" Command="{Binding ShowSummaryCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>