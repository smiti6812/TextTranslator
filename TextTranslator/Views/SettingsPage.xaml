<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TextTranslator.Views.SettingsPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Entry Placeholder="OCR API Key" Text="{Binding OcrApiKey}" />
            <Entry Placeholder="Translation API Key" Text="{Binding TranslationApiKey}" />
            <Entry Placeholder="Translation Endpoint" Text="{Binding TranslationEndpoint}" />
            <HorizontalStackLayout Spacing="10">
                <Label Text="Auto translate importkor" VerticalOptions="Center" />
                <Switch IsToggled="{Binding AutoTranslateOnImport}" />
            </HorizontalStackLayout>

            <Button Text="Mentés" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>