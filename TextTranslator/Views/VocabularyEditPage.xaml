<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TextTranslator.Views.VocabularyEditPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Entry Placeholder="Forrás nyelv (pl. nl)" Text="{Binding SourceLanguage}" />
            <Entry Placeholder="Forrás szó" Text="{Binding SourceWord}" />
            <Entry Placeholder="Cél nyelv (pl. hu)" Text="{Binding TargetLanguage}" />
            <Entry Placeholder="Fordítás" Text="{Binding TargetWord}" />
            <Entry Placeholder="Szófaj" Text="{Binding PartOfSpeech}" />
            <Editor Placeholder="Megjegyzés" Text="{Binding Note}" AutoSize="TextChanges" />
            <Editor Placeholder="Eredeti szöveg" Text="{Binding SourceText}" AutoSize="TextChanges" HeightRequest="120" />
            <Button Text="Mentés" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>